{
  "name": "water-delivery-system",
  "version": "2.0.0",
  "description": "桶装水配送管理系统 - 全新重构版本",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon backend/server.js",
    "dev:frontend": "cd frontend && vite",
    "build": "cd frontend && vite build",
    "preview": "cd frontend && vite preview",
    "install:all": "npm install && cd frontend && npm install"
  },
  "keywords": [
    "water-delivery",
    "delivery-management",
    "vue3",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "better-sqlite3": "^9.0.0",
    "dotenv": "^16.3.1"
  }
}
